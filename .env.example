# --- Vercel KV (Redis) ---
# Provision a KV / Upstash Redis store from the Vercel dashboard
# (Storage -> Create -> KV). Vercel injects these automatically on deploy;
# for local dev run `vercel env pull .env.local` or paste them here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Vercel Blob (image uploads) ---
# Provision a Blob store from the Vercel dashboard (Storage -> Create -> Blob).
# Powers the "Carica file" button in /admin-cms; uploaded images get a public
# URL saved in the project's `image` field. Vercel injects this on deploy;
# for local dev run `vercel env pull .env.local`.
# NB: the store is connected with the `blob_gam` prefix, so on Vercel the var is
# named blob_gam_READ_WRITE_TOKEN. The upload route reads that first and falls
# back to BLOB_READ_WRITE_TOKEN if a default-prefix connection is ever used.
blob_gam_READ_WRITE_TOKEN=

# --- Admin CMS ---
# Password protecting the hidden /admin-cms project editor.
# This is a single shared secret with no expiry, so make it long and random
# (`openssl rand -base64 32`) and set it in the Vercel project's Environment
# Variables. Failed attempts are rate-limited per IP via KV (10 tries / 10 min);
# without KV configured that lockout is skipped, so the password is the only
# line of defence.
ADMIN_CMS_PASSWORD=change-me

# --- Contact form (Resend) ---
# Create a key at https://resend.com (API Keys). Required to send mail.
RESEND_API_KEY=
# Where contact submissions are delivered.
CONTACT_TO=info@gamgroup.it
# Sender — MUST be on a domain verified in Resend (e.g. noreply@gamgroup.it).
# Leave as onboarding@resend.dev only for testing (delivers to the account owner).
CONTACT_FROM=GAM Group <onboarding@resend.dev>

